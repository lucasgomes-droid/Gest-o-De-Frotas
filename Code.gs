// Cria todas as abas com os cabeçalhos corretos e alguns dados de exemplo.
// Pode ser rodada de novo com segurança: abas que já existem só têm o
// cabeçalho reescrito, e os dados de exemplo só entram em aba vazia.
function configurarPlanilha() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  Object.keys(HEADERS).forEach(function (sheetName) {
    let sheet = ss.getSheetByName(sheetName);
    if (!sheet) sheet = ss.insertSheet(sheetName);
    const headers = HEADERS[sheetName];
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.setFrozenRows(1);
    sheet.getRange(1, 1, 1, headers.length).setFontWeight('bold');
  });

  const agora = nowIso_();

  // Seed inicial de exemplo (pode editar/apagar depois direto na planilha)
  seedIfEmpty_(SHEETS.UNIDADES, [
    ['UNI-001', 'Macatuba', 'SIM'],
    ['UNI-002', 'Jundiaí', 'SIM'],
    ['UNI-003', 'Jundiaí II', 'SIM']
  ]);

  // TIPO = ADMIN (entra com senha) ou OPERADOR (só escolhe o nome na lista).
  // UNIDADE = 'TODAS' dá acesso de consulta a todas as unidades.
  seedIfEmpty_(SHEETS.USUARIOS, [
    ['USR-001', 'Lucas', 'lucas', 'Macatuba', 'ADMIN', '1234', 'SIM'],
    ['USR-002', 'João', 'joao', 'Macatuba', 'OPERADOR', '', 'SIM'],
    ['USR-003', 'Gerente', 'gerente', 'TODAS', 'ADMIN', '1234', 'SIM']
  ]);

  // Nomes que aparecem no campo "Responsável" ao preencher um checklist.
  // Não são usuários do app — é só a lista de quem pode assinar o checklist.
  seedIfEmpty_(SHEETS.RESPONSAVEIS, [
    ['RES-001', 'Macatuba', 'João da Silva', 'SIM'],
    ['RES-002', 'Macatuba', 'Maria Souza', 'SIM']
  ]);

  seedIfEmpty_(SHEETS.EQUIPAMENTOS, [
    ['EQP-001', 'Macatuba', 'Empilhadeira 01', 'EMP-01', 'Empilhadeira', 'em_uso', agora, 'Equipamento de exemplo', agora],
    ['EQP-002', 'Macatuba', 'Lavadora de Piso 01', 'LAV-01', 'Lavadoras de Piso Industrial', 'em_uso', agora, '', agora],
    ['EQP-003', 'Macatuba', 'Paleteira Elétrica 01', 'PAL-01', 'Paleteira Elétrica', 'parado', agora, 'Aguardando peça', agora]
  ]);

  SpreadsheetApp.flush();
  return 'Planilha configurada com sucesso.';
}

function seedIfEmpty_(sheetName, rows) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(sheetName);
  if (!sheet || !rows || !rows.length) return;
  if (sheet.getLastRow() <= 1) {
    sheet.getRange(2, 1, rows.length, rows[0].length).setValues(rows);
  }
}

// ======================= ENTRY POINTS HTTP =======================

function doGet(e) {
  try {
    const params = (e && e.parameter) ? e.parameter : {};
    const result = routeAction_(params.action, params);
    return jsonOut_(result);
  } catch (err) {
    return jsonOut_({ ok: false, error: err.message || String(err) });
  }
}

function doPost(e) {
  try {
    const body = JSON.parse(e.postData.contents);
    const result = routeAction_(body.action, body.payload || {});
    return jsonOut_(result);
  } catch (err) {
    return jsonOut_({ ok: false, error: err.message || String(err) });
  }
}

function jsonOut_(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}

// Roteador único da API. Ações de leitura rodam sem trava; ações que
// escrevem na planilha pegam a trava do script para não haver duas
// gravações simultâneas gerando o mesmo ID.
function routeAction_(action, params) {
  const readOnlyActions = [
    'getUnidades', 'getUsuarios', 'getResponsaveis', 'getEquipamentos',
    'getTiposEquipamento', 'getChecklistItensModelo', 'getChecklists',
    'getChecklistDetalhe', 'getNaoConformidades', 'getManutencoes',
    'getPainel', 'getRelatorio', 'getHistorico'
  ];
  const precisaTrava = readOnlyActions.indexOf(action) === -1;
  const lock = LockService.getScriptLock();
  if (precisaTrava) lock.waitLock(20000);

  try {
    switch (action) {
      // ---- configuração / login ----
      case 'getUnidades': return { ok: true, data: getUnidades_() };
      case 'getUsuarios': return { ok: true, data: getUsuarios_(params.unidade) };
      case 'loginAdmin': return loginAdmin_(params);

      // ---- responsáveis do checklist ----
      case 'getResponsaveis': return { ok: true, data: getResponsaveis_(params.unidade) };
      case 'createResponsavel': return criarResponsavel_(params);
      case 'deleteResponsavel': return deletarResponsavel_(params);

      // ---- equipamentos ----
      case 'getTiposEquipamento': return { ok: true, data: TIPOS_EQUIPAMENTO.concat(['Outro']) };
      case 'getEquipamentos': return { ok: true, data: getEquipamentos_(params) };
      case 'createEquipamento': return criarEquipamento_(params);
      case 'updateEquipamento': return atualizarEquipamento_(params);
      case 'deleteEquipamento': return deletarEquipamento_(params);

      // ---- checklists ----
      case 'getChecklistItensModelo': return { ok: true, data: CHECKLIST_ITENS_PADRAO };
      case 'getChecklists': return { ok: true, data: getChecklists_(params) };
      case 'getChecklistDetalhe': return { ok: true, data: getChecklistDetalhe_(params.idChecklist) };
      case 'createChecklist': return criarChecklist_(params);

      // ---- não conformidades ----
      case 'getNaoConformidades': return { ok: true, data: getNaoConformidades_(params) };
      case 'updateStatusNaoConformidade': return atualizarStatusNaoConformidade_(params);

      // ---- manutenções ----
      case 'getManutencoes': return { ok: true, data: getManutencoes_(params) };
      case 'createManutencao': return criarManutencao_(params);
      case 'updateManutencao': return atualizarManutencao_(params);

      // ---- painel, relatórios e histórico ----
      case 'getPainel': return { ok: true, data: getPainel_(params) };
      case 'getRelatorio': return { ok: true, data: getRelatorio_(params) };
      case 'gerarRelatorioPDF': return { ok: true, data: gerarRelatorioPDF_(params) };
      case 'getHistorico': return { ok: true, data: getHistorico_(params) };

      default: return { ok: false, error: 'Ação desconhecida: ' + action };
    }
  } catch (err) {
    return { ok: false, error: err.message || String(err) };
  } finally {
    if (precisaTrava) lock.releaseLock();
  }
}

// ======================= HELPERS DE PLANILHA =======================

function sheet_(name) {
  const sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sh) throw new Error('A aba "' + name + '" não existe na planilha. Rode a função configurarPlanilha() uma vez no editor do Apps Script.');
  return sh;
}

// Lê uma aba inteira e devolve um array de objetos { CABECALHO: valor }.
// Datas: o Google Sheets às vezes converte sozinho um texto de data digitado
// na célula em um valor de data real. Aqui qualquer Date volta para texto
// ISO, para o app sempre receber o mesmo formato.
function readSheet_(name) {
  const sh = sheet_(name);
  const valores = sh.getDataRange().getValues();
  if (!valores.length) return [];
  const headers = valores[0];
  return valores.slice(1)
    .filter(function (r) { return r.join('') !== ''; })
    .map(function (r) {
      const obj = {};
      headers.forEach(function (h, i) {
        let v = r[i];
        if (v instanceof Date) v = toIso_(v);
        obj[h] = v;
      });
      return obj;
    });
}

function appendRow_(sheetName, rowObj) {
  const sh = sheet_(sheetName);
  const headers = HEADERS[sheetName];
  const row = headers.map(function (h) { return rowObj[h] !== undefined && rowObj[h] !== null ? rowObj[h] : ''; });
  sh.appendRow(row);
}

// Grava várias linhas de uma vez (bem mais rápido que appendRow_ em loop —
// usado ao salvar os 7 itens de um checklist).
function appendRows_(sheetName, rowObjs) {
  if (!rowObjs || !rowObjs.length) return;
  const sh = sheet_(sheetName);
  const headers = HEADERS[sheetName];
  const matriz = rowObjs.map(function (rowObj) {
    return headers.map(function (h) { return rowObj[h] !== undefined && rowObj[h] !== null ? rowObj[h] : ''; });
  });
  sh.getRange(sh.getLastRow() + 1, 1, matriz.length, headers.length).setValues(matriz);
}

// Atualiza campos de uma linha identificada por um valor de ID numa coluna.
function updateRowById_(sheetName, idColumn, idValue, updates) {
  const sh = sheet_(sheetName);
  const valores = sh.getDataRange().getValues();
  const headers = valores[0];
  const idIdx = headers.indexOf(idColumn);
  if (idIdx === -1) return false;
  for (let i = 1; i < valores.length; i++) {
    if (String(valores[i][idIdx]) === String(idValue)) {
      Object.keys(updates).forEach(function (key) {
        const colIdx = headers.indexOf(key);
        if (colIdx > -1) sh.getRange(i + 1, colIdx + 1).setValue(updates[key]);
      });
      return true;
    }
  }
  return false;
}

function removeRowById_(sheetName, idColumn, idValue) {
  const sh = sheet_(sheetName);
  const valores = sh.getDataRange().getValues();
  const headers = valores[0];
  const idIdx = headers.indexOf(idColumn);
  if (idIdx === -1) return false;
  for (let i = 1; i < valores.length; i++) {
    if (String(valores[i][idIdx]) === String(idValue)) {
      sh.deleteRow(i + 1);
      return true;
    }
  }
  return false;
}

function findRowById_(sheetName, idColumn, idValue) {
  const rows = readSheet_(sheetName);
  return rows.find(function (r) { return String(r[idColumn]) === String(idValue); }) || null;
}

// Gera IDs sequenciais únicos, ex: MAN-000001, CHK-000001, NC-000001.
function nextId_(prefix) {
  const sh = sheet_(SHEETS.SEQ);
  const valores = sh.getDataRange().getValues();
  for (let i = 1; i < valores.length; i++) {
    if (String(valores[i][0]) === prefix) {
      const proximo = Number(valores[i][1] || 0) + 1;
      sh.getRange(i + 1, 2).setValue(proximo);
      return prefix + '-' + String(proximo).padStart(6, '0');
    }
  }
  sh.appendRow([prefix, 1]);
  return prefix + '-000001';
}

// ======================= HELPERS DE DATA =======================

function fusoHorario_() {
  return Session.getScriptTimeZone() || 'America/Sao_Paulo';
}

// Converte um Date para texto ISO com fuso (ex: 2026-09-10T14:32:00-03:00).
function toIso_(date) {
  const tz = fusoHorario_();
  const base = Utilities.formatDate(date, tz, "yyyy-MM-dd'T'HH:mm:ss");
  const offset = Utilities.formatDate(date, tz, 'Z'); // ex: -0300
  return base + offset.slice(0, 3) + ':' + offset.slice(3);
}

// Reserva vários IDs sequenciais de uma vez só (ex: os 7 itens de um
// checklist), com uma única leitura/escrita na aba _SEQ.
function nextIds_(prefix, quantidade) {
  const total = Number(quantidade || 0);
  if (total <= 0) return [];
  const sh = sheet_(SHEETS.SEQ);
  const valores = sh.getDataRange().getValues();
  let anterior = 0;
  let linha = -1;
  for (let i = 1; i < valores.length; i++) {
    if (String(valores[i][0]) === prefix) {
      anterior = Number(valores[i][1] || 0);
      linha = i + 1;
      break;
    }
  }
  const ids = [];
  for (let n = 1; n <= total; n++) {
    ids.push(prefix + '-' + String(anterior + n).padStart(6, '0'));
  }
  if (linha > -1) sh.getRange(linha, 2).setValue(anterior + total);
  else sh.appendRow([prefix, total]);
  return ids;
}

function nowIso_() {
  return toIso_(new Date());
}

// Aceita Date, texto ISO, "dd/MM/yyyy" e "dd/MM/yyyy HH:mm". Devolve Date
// ou null quando o valor está vazio/inválido — nunca lança erro, para um
// registro antigo com data estranha não derrubar um dashboard inteiro.
function parseData_(valor) {
  if (!valor && valor !== 0) return null;
  if (valor instanceof Date) return isNaN(valor.getTime()) ? null : valor;
  const texto = String(valor).trim();
  if (!texto) return null;

  const br = texto.match(/^(\d{2})\/(\d{2})\/(\d{4})(?:[ T](\d{2}):(\d{2})(?::(\d{2}))?)?$/);
  if (br) {
    return new Date(Number(br[3]), Number(br[2]) - 1, Number(br[1]),
      Number(br[4] || 0), Number(br[5] || 0), Number(br[6] || 0));
  }
  const soData = texto.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (soData) {
    return new Date(Number(soData[1]), Number(soData[2]) - 1, Number(soData[3]));
  }
  const d = new Date(texto);
  return isNaN(d.getTime()) ? null : d;
}

// Normaliza qualquer entrada de data para texto ISO (ou '' se vazia).
function normalizarDataIso_(valor) {
  const d = parseData_(valor);
  return d ? toIso_(d) : '';
}

function inicioDoDia_(date) {
  const d = new Date(date.getTime());
  d.setHours(0, 0, 0, 0);
  return d;
}

function fimDoDia_(date) {
  const d = new Date(date.getTime());
  d.setHours(23, 59, 59, 999);
  return d;
}

function mesmoDia_(a, b) {
  if (!a || !b) return false;
  return a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
}

function formatarDataBr_(valor) {
  const d = parseData_(valor);
  if (!d) return '-';
  return Utilities.formatDate(d, fusoHorario_(), 'dd/MM/yyyy');
}

function formatarDataHoraBr_(valor) {
  const d = parseData_(valor);
  if (!d) return '-';
  return Utilities.formatDate(d, fusoHorario_(), 'dd/MM/yyyy HH:mm');
}

// Transforma uma duração em milissegundos num texto curto e legível
// ("3d 4h", "6h", "45min") — usado no ranking e na lista de parados.
function formatarDuracao_(ms) {
  const total = (!ms || ms < 0) ? 0 : ms;
  const minutos = Math.floor(total / 60000);
  const dias = Math.floor(minutos / 1440);
  const horas = Math.floor((minutos % 1440) / 60);
  if (dias > 0) return dias + 'd ' + horas + 'h';
  if (horas > 0) return horas + 'h ' + (minutos % 60) + 'min';
  return minutos + 'min';
}

// Resolve o período pedido pelo app em uma janela de datas concreta.
// periodo: 'semana' (últimos 7 dias), 'mes' (últimos 30 dias),
// 'todos' (sem limite) ou 'custom' (usa dataInicio/dataFim).
function resolverPeriodo_(params) {
  const tipo = String((params && params.periodo) || 'mes').toLowerCase();
  const hoje = new Date();

  if (tipo === 'todos' || tipo === 'tudo') {
    return { tipo: 'todos', inicio: null, fim: null, label: 'Todo o período' };
  }
  if (tipo === 'custom' || tipo === 'personalizado') {
    const di = parseData_(params.dataInicio);
    const df = parseData_(params.dataFim);
    const inicio = di ? inicioDoDia_(di) : null;
    const fim = df ? fimDoDia_(df) : fimDoDia_(hoje);
    return {
      tipo: 'custom', inicio: inicio, fim: fim,
      label: (inicio ? formatarDataBr_(inicio) : 'início') + ' a ' + formatarDataBr_(fim)
    };
  }
  const dias = (tipo === 'semana') ? 7 : 30;
  const inicio = inicioDoDia_(new Date(hoje.getTime() - (dias - 1) * 86400000));
  const fim = fimDoDia_(hoje);
  return {
    tipo: (tipo === 'semana') ? 'semana' : 'mes',
    inicio: inicio, fim: fim,
    label: (tipo === 'semana' ? 'Últimos 7 dias' : 'Últimos 30 dias') +
      ' (' + formatarDataBr_(inicio) + ' a ' + formatarDataBr_(fim) + ')'
  };
}

// Diz se uma data cai dentro da janela do período (janela aberta = sempre sim).
function dentroDoPeriodo_(valor, janela) {
  if (!janela || (!janela.inicio && !janela.fim)) return true;
  const d = parseData_(valor);
  if (!d) return false;
  if (janela.inicio && d < janela.inicio) return false;
  if (janela.fim && d > janela.fim) return false;
  return true;
}

// ======================= HELPERS DE FOTO (Google Drive) =======================

function pastaPorNome_(nome) {
  const pastas = DriveApp.getFoldersByName(nome);
  return pastas.hasNext() ? pastas.next() : DriveApp.createFolder(nome);
}

// Recebe a foto em base64 (data URL vinda do app), salva como arquivo numa
// pasta do Drive e devolve o link de visualização que vai para a planilha.
function salvarFoto_(dataUrl, nomeArquivo) {
  if (!dataUrl) return '';
  const texto = String(dataUrl);
  // Se já veio um link (edição de registro que não trocou a foto), devolve igual.
  if (texto.indexOf('http') === 0) return texto;
  const match = texto.match(/^data:(.+);base64,(.*)$/);
  if (!match) return '';
  const contentType = match[1];
  const bytes = Utilities.base64Decode(match[2]);
  const blob = Utilities.newBlob(bytes, contentType, nomeArquivo || ('foto_' + new Date().getTime()));

  const folder = pastaPorNome_(FOLDER_NAME);
  const file = folder.createFile(blob);
  file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  // O endpoint de thumbnail é o que carrega de forma confiável dentro de
  // uma tag <img> no navegador (o formato "uc?id=" costuma falhar).
  return 'https://drive.google.com/thumbnail?id=' + file.getId() + '&sz=w1000';
}

// Separador usado quando mais de uma foto é guardada na mesma célula.
const FOTO_SEP = '|||';

function salvarFotos_(dataUrls, nomeArquivoBase) {
  const lista = Array.isArray(dataUrls) ? dataUrls : (dataUrls ? [dataUrls] : []);
  return lista
    .map(function (dataUrl, i) {
      return salvarFoto_(dataUrl, nomeArquivoBase + (lista.length > 1 ? '_' + (i + 1) : ''));
    })
    .filter(function (url) { return !!url; })
    .join(FOTO_SEP);
}

// ======================= HELPERS DE UNIDADE / PERMISSÃO =======================

function ehTodasUnidades_(unidade) {
  return String(unidade || '').trim().toUpperCase() === 'TODAS';
}

// Isolamento por unidade: filtra qualquer lista de registros pela unidade
// pedida. "TODAS" (gerente/coordenador) devolve tudo, sem filtro.
function filtrarPorUnidade_(rows, unidade) {
  if (ehTodasUnidades_(unidade)) return rows;
  const alvo = String(unidade || '').trim();
  if (!alvo) return [];
  return rows.filter(function (r) { return String(r.UNIDADE || '').trim() === alvo; });
}

// Para CRIAR qualquer registro é obrigatório estar dentro de uma unidade
// específica — nem mesmo um admin com acesso a TODAS pode gravar sem
// escolher em qual unidade o registro entra.
function exigirUnidade_(unidade) {
  const alvo = String(unidade || '').trim();
  if (!alvo) throw new Error('Informe a unidade para registrar.');
  if (ehTodasUnidades_(alvo)) {
    throw new Error('Selecione uma unidade específica antes de registrar (não é possível gravar em "TODAS").');
  }
  const existe = readSheet_(SHEETS.UNIDADES).some(function (u) {
    return String(u.UNIDADE).trim() === alvo && String(u.ATIVO).toUpperCase() === 'SIM';
  });
  if (!existe) throw new Error('Unidade não encontrada ou inativa: ' + alvo);
  return alvo;
}

// Validação mínima de acesso no servidor: se o app mandar o idUsuario,
// conferimos que aquele usuário realmente pertence à unidade em que está
// tentando gravar (ou tem acesso a TODAS). Sem idUsuario, segue em frente —
// o controle fica no frontend, como no app de referência.
function validarAcessoUnidade_(idUsuario, unidade) {
  if (!idUsuario) return;
  const usuario = findRowById_(SHEETS.USUARIOS, 'ID_USUARIO', idUsuario);
  if (!usuario) throw new Error('Usuário não encontrado.');
  if (String(usuario.ATIVO).toUpperCase() !== 'SIM') throw new Error('Usuário inativo.');
  if (ehTodasUnidades_(usuario.UNIDADE)) return;
  if (String(usuario.UNIDADE).trim() !== String(unidade).trim()) {
    throw new Error('Este usuário não tem acesso à unidade ' + unidade + '.');
  }
}

// Busca o equipamento e garante que ele é mesmo da unidade informada —
// impede que um registro caia na unidade errada por engano do app.
function equipamentoDaUnidade_(idEquipamento, unidade) {
  const equipamento = findRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', idEquipamento);
  if (!equipamento) throw new Error('Equipamento não encontrado: ' + idEquipamento);
  if (String(equipamento.UNIDADE).trim() !== String(unidade).trim()) {
    throw new Error('O equipamento selecionado pertence à unidade ' + equipamento.UNIDADE + ', não à unidade ' + unidade + '.');
  }
  return equipamento;
}

function textoLimpo_(valor) {
  return String(valor === undefined || valor === null ? '' : valor).trim();
}

// Agrupa contando ocorrências por um campo (ex: quantas manutenções por status).
function agruparContagem_(rows, campo) {
  const out = {};
  (rows || []).forEach(function (r) {
    const chave = textoLimpo_(r[campo]) || '(vazio)';
    out[chave] = (out[chave] || 0) + 1;
  });
  return out;
}

// ======================= CONFIGURAÇÃO: UNIDADES, USUÁRIOS, RESPONSÁVEIS =======================

function getUnidades_() {
  return readSheet_(SHEETS.UNIDADES)
    .filter(function (u) { return String(u.ATIVO).toUpperCase() === 'SIM'; })
    .map(function (u) { return { ID_UNIDADE: u.ID_UNIDADE, UNIDADE: u.UNIDADE }; });
}

// Lista os usuários que podem entrar na unidade escolhida. Quem tem
// UNIDADE = 'TODAS' aparece na lista de qualquer unidade.
// A coluna SENHA NUNCA é devolvida ao frontend.
function getUsuarios_(unidade) {
  const alvo = textoLimpo_(unidade);
  return readSheet_(SHEETS.USUARIOS)
    .filter(function (u) {
      if (String(u.ATIVO).toUpperCase() !== 'SIM') return false;
      if (ehTodasUnidades_(u.UNIDADE)) return true;
      if (!alvo || ehTodasUnidades_(alvo)) return true;
      return String(u.UNIDADE).trim() === alvo;
    })
    .map(function (u) {
      return {
        ID_USUARIO: u.ID_USUARIO,
        NOME: u.NOME,
        USUARIO: u.USUARIO,
        TIPO: String(u.TIPO || 'OPERADOR').toUpperCase(),
        UNIDADE: u.UNIDADE
      };
    });
}

// Só o ADMIN tem senha conferida. O OPERADOR entra escolhendo o nome na
// lista devolvida por getUsuarios (sem senha nenhuma) — é assim de
// propósito, replicando o app de referência.
function loginAdmin_(params) {
  const usuario = readSheet_(SHEETS.USUARIOS).find(function (u) {
    return String(u.ID_USUARIO) === String(params.idUsuario) && String(u.ATIVO).toUpperCase() === 'SIM';
  });
  if (!usuario) return { ok: false, error: 'Usuário não encontrado.' };
  if (String(usuario.TIPO).toUpperCase() !== 'ADMIN') {
    return { ok: false, error: 'Este usuário não é administrador.' };
  }
  if (String(usuario.SENHA) !== String(params.senha)) return { ok: false, error: 'Senha incorreta.' };
  return {
    ok: true,
    data: {
      ID_USUARIO: usuario.ID_USUARIO,
      NOME: usuario.NOME,
      USUARIO: usuario.USUARIO,
      TIPO: String(usuario.TIPO).toUpperCase(),
      UNIDADE: usuario.UNIDADE
    }
  };
}

// Responsáveis são os nomes selecionáveis no campo "Responsável" do
// checklist — lista fechada, para não haver nome digitado de qualquer jeito.
function getResponsaveis_(unidade) {
  const ativos = readSheet_(SHEETS.RESPONSAVEIS).filter(function (r) {
    return String(r.ATIVO).toUpperCase() === 'SIM';
  });
  return filtrarPorUnidade_(ativos, unidade).sort(function (a, b) {
    return String(a.NOME).localeCompare(String(b.NOME));
  });
}

function criarResponsavel_(p) {
  const unidade = exigirUnidade_(p.unidade);
  validarAcessoUnidade_(p.idUsuario, unidade);
  const nome = textoLimpo_(p.nome);
  if (!nome) throw new Error('Informe o nome do responsável.');

  const jaExiste = readSheet_(SHEETS.RESPONSAVEIS).some(function (r) {
    return String(r.UNIDADE).trim() === unidade &&
      String(r.NOME).trim().toLowerCase() === nome.toLowerCase() &&
      String(r.ATIVO).toUpperCase() === 'SIM';
  });
  if (jaExiste) throw new Error('Já existe um responsável com esse nome nesta unidade.');

  const idResponsavel = nextId_('RES');
  appendRow_(SHEETS.RESPONSAVEIS, {
    ID_RESPONSAVEL: idResponsavel, UNIDADE: unidade, NOME: nome, ATIVO: 'SIM'
  });
  return { ok: true, data: { ID_RESPONSAVEL: idResponsavel, UNIDADE: unidade, NOME: nome, ATIVO: 'SIM' } };
}

// Exclusão lógica (ATIVO = NAO): o nome some da lista de seleção mas os
// checklists antigos que ele assinou continuam íntegros no histórico.
function deletarResponsavel_(p) {
  const id = textoLimpo_(p.idResponsavel);
  if (!id) throw new Error('Informe o responsável a excluir.');
  const ok = updateRowById_(SHEETS.RESPONSAVEIS, 'ID_RESPONSAVEL', id, { ATIVO: 'NAO' });
  if (!ok) throw new Error('Responsável não encontrado.');
  return { ok: true, data: { ID_RESPONSAVEL: id, removido: true } };
}

// ======================= EQUIPAMENTOS =======================

// filtros aceitos: tipo, status, busca (nome ou código), incluirInativos.
function getEquipamentos_(params) {
  let rows = filtrarPorUnidade_(readSheet_(SHEETS.EQUIPAMENTOS), params.unidade);

  const incluirInativos = String(params.incluirInativos || '').toLowerCase() === 'true' ||
    params.incluirInativos === true;
  if (!incluirInativos) {
    rows = rows.filter(function (e) { return String(e.STATUS) !== 'inativo'; });
  }
  const tipo = textoLimpo_(params.tipo);
  if (tipo) rows = rows.filter(function (e) { return String(e.TIPO) === tipo; });

  const status = textoLimpo_(params.status);
  if (status) rows = rows.filter(function (e) { return String(e.STATUS) === status; });

  const busca = textoLimpo_(params.busca).toLowerCase();
  if (busca) {
    rows = rows.filter(function (e) {
      return String(e.NOME).toLowerCase().indexOf(busca) > -1 ||
        String(e.CODIGO).toLowerCase().indexOf(busca) > -1;
    });
  }

  const agora = new Date();
  return rows
    .map(function (e) {
      const desde = parseData_(e.STATUS_DESDE) || parseData_(e.CRIADO_EM);
      const ms = desde ? (agora.getTime() - desde.getTime()) : 0;
      // tempoNoStatus é o "tempo parado" quando o status é parado/manutencao.
      e.TEMPO_NO_STATUS_MS = ms;
      e.TEMPO_NO_STATUS_TEXTO = desde ? formatarDuracao_(ms) : '-';
      return e;
    })
    .sort(function (a, b) { return String(a.NOME).localeCompare(String(b.NOME)); });
}

function criarEquipamento_(p) {
  const unidade = exigirUnidade_(p.unidade);
  validarAcessoUnidade_(p.idUsuario, unidade);

  const nome = textoLimpo_(p.nome);
  if (!nome) throw new Error('Informe o nome do equipamento.');
  const tipo = textoLimpo_(p.tipo) || 'Outro';
  const status = textoLimpo_(p.status) || 'em_uso';
  if (STATUS_EQUIPAMENTO.indexOf(status) === -1) {
    throw new Error('Status inválido: ' + status + '. Use em_uso, manutencao, parado ou inativo.');
  }
  const codigo = textoLimpo_(p.codigo);
  if (codigo) {
    const duplicado = readSheet_(SHEETS.EQUIPAMENTOS).some(function (e) {
      return String(e.UNIDADE).trim() === unidade &&
        textoLimpo_(e.CODIGO).toLowerCase() === codigo.toLowerCase();
    });
    if (duplicado) throw new Error('Já existe um equipamento com o código ' + codigo + ' nesta unidade.');
  }

  const agora = nowIso_();
  const idEquipamento = nextId_('EQP');
  const registro = {
    ID_EQUIPAMENTO: idEquipamento,
    UNIDADE: unidade,
    NOME: nome,
    CODIGO: codigo,
    TIPO: tipo,
    STATUS: status,
    STATUS_DESDE: agora,
    OBSERVACOES: textoLimpo_(p.observacoes),
    CRIADO_EM: agora
  };
  appendRow_(SHEETS.EQUIPAMENTOS, registro);
  return { ok: true, data: registro };
}

// Toda troca de STATUS regrava STATUS_DESDE com a data/hora do momento —
// é esse carimbo que depois vira o "tempo parado" nos relatórios.
function atualizarEquipamento_(p) {
  const id = textoLimpo_(p.idEquipamento);
  if (!id) throw new Error('Informe o equipamento a atualizar.');
  const atual = findRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', id);
  if (!atual) throw new Error('Equipamento não encontrado.');
  validarAcessoUnidade_(p.idUsuario, atual.UNIDADE);

  const updates = {};
  if (p.nome !== undefined) {
    const nome = textoLimpo_(p.nome);
    if (!nome) throw new Error('O nome do equipamento não pode ficar em branco.');
    updates.NOME = nome;
  }
  if (p.codigo !== undefined) updates.CODIGO = textoLimpo_(p.codigo);
  if (p.tipo !== undefined) updates.TIPO = textoLimpo_(p.tipo) || 'Outro';
  if (p.observacoes !== undefined) updates.OBSERVACOES = textoLimpo_(p.observacoes);

  if (p.status !== undefined) {
    const status = textoLimpo_(p.status);
    if (STATUS_EQUIPAMENTO.indexOf(status) === -1) {
      throw new Error('Status inválido: ' + status + '. Use em_uso, manutencao, parado ou inativo.');
    }
    updates.STATUS = status;
    if (status !== String(atual.STATUS)) updates.STATUS_DESDE = nowIso_();
  }

  // Mudou o nome do equipamento? Os registros ligados a ele guardam o nome
  // por cópia (para o histórico não quebrar), então atualizamos junto.
  updateRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', id, updates);
  if (updates.NOME && updates.NOME !== String(atual.NOME)) {
    propagarNomeEquipamento_(id, updates.NOME);
  }

  return { ok: true, data: findRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', id) };
}

function propagarNomeEquipamento_(idEquipamento, novoNome) {
  [SHEETS.CHECKLISTS, SHEETS.NAO_CONFORMIDADES, SHEETS.MANUTENCOES].forEach(function (aba) {
    const sh = sheet_(aba);
    const valores = sh.getDataRange().getValues();
    const headers = valores[0];
    const idxId = headers.indexOf('ID_EQUIPAMENTO');
    const idxNome = headers.indexOf('NOME_EQUIPAMENTO');
    if (idxId === -1 || idxNome === -1) return;
    for (let i = 1; i < valores.length; i++) {
      if (String(valores[i][idxId]) === String(idEquipamento) && String(valores[i][idxNome]) !== novoNome) {
        sh.getRange(i + 1, idxNome + 1).setValue(novoNome);
      }
    }
  });
}

// Só apaga de verdade um equipamento que ainda não tem histórico nenhum.
// Se já tiver checklist, manutenção ou não conformidade, ele é apenas
// marcado como inativo — o histórico da frota não pode ficar órfão.
function deletarEquipamento_(p) {
  const id = textoLimpo_(p.idEquipamento);
  if (!id) throw new Error('Informe o equipamento a excluir.');
  const atual = findRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', id);
  if (!atual) throw new Error('Equipamento não encontrado.');
  validarAcessoUnidade_(p.idUsuario, atual.UNIDADE);

  const temVinculo = [SHEETS.CHECKLISTS, SHEETS.NAO_CONFORMIDADES, SHEETS.MANUTENCOES].some(function (aba) {
    return readSheet_(aba).some(function (r) { return String(r.ID_EQUIPAMENTO) === id; });
  });

  if (temVinculo) {
    updateRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', id, { STATUS: 'inativo', STATUS_DESDE: nowIso_() });
    return {
      ok: true,
      data: {
        ID_EQUIPAMENTO: id, excluido: false, inativado: true,
        mensagem: 'O equipamento tem histórico registrado, então foi marcado como inativo em vez de excluído.'
      }
    };
  }
  removeRowById_(SHEETS.EQUIPAMENTOS, 'ID_EQUIPAMENTO', id);
  return { ok: true, data: { ID_EQUIPAMENTO: id, excluido: true, inativado: false } };
}

// ======================= CHECKLISTS =======================

// filtros aceitos: idEquipamento, status ('ok'/'pendencia'), responsavel,
// periodo + dataInicio/dataFim.
function getChecklists_(params) {
  const janela = resolverPeriodo_(Object.assign({ periodo: params.periodo || 'todos' }, params));
  let rows = filtrarPorUnidade_(readSheet_(SHEETS.CHECKLISTS), params.unidade);

  const idEquipamento = textoLimpo_(params.idEquipamento);
  if (idEquipamento) rows = rows.filter(function (c) { return String(c.ID_EQUIPAMENTO) === idEquipamento; });

  const status = textoLimpo_(params.status);
  if (status) rows = rows.filter(function (c) { return String(c.STATUS) === status; });

  const responsavel = textoLimpo_(params.responsavel);
  if (responsavel) rows = rows.filter(function (c) { return String(c.RESPONSAVEL) === responsavel; });

  rows = rows.filter(function (c) { return dentroDoPeriodo_(c.DATA_HORA, janela); });

  // Anexa os itens respondidos de cada checklist, para o app já mostrar o
  // detalhe sem precisar de uma segunda chamada por linha da lista.
  const itensPorChecklist = {};
  readSheet_(SHEETS.CHECKLIST_ITENS).forEach(function (it) {
    const chave = String(it.ID_CHECKLIST);
    if (!itensPorChecklist[chave]) itensPorChecklist[chave] = [];
    itensPorChecklist[chave].push(it);
  });
  rows.forEach(function (c) { c.ITENS = itensPorChecklist[String(c.ID_CHECKLIST)] || []; });

  return rows.sort(function (a, b) { return ordenarPorDataDesc_(a.DATA_HORA, b.DATA_HORA); });
}

function getChecklistDetalhe_(idChecklist) {
  const id = textoLimpo_(idChecklist);
  if (!id) throw new Error('Informe o checklist.');
  const checklist = findRowById_(SHEETS.CHECKLISTS, 'ID_CHECKLIST', id);
  if (!checklist) throw new Error('Checklist não encontrado.');
  checklist.ITENS = readSheet_(SHEETS.CHECKLIST_ITENS).filter(function (it) {
    return String(it.ID_CHECKLIST) === id;
  });
  checklist.NAO_CONFORMIDADES = readSheet_(SHEETS.NAO_CONFORMIDADES).filter(function (nc) {
    return String(nc.ID_CHECKLIST_ORIGEM) === id;
  });
  return checklist;
}

/**
 * Cria um checklist inteiro numa tacada:
 *  - grava o cabeçalho em CHECKLISTS (com a foto obrigatória do equipamento);
 *  - grava as 7 respostas em CHECKLIST_ITENS;
 *  - para cada item respondido NOK, abre automaticamente uma não
 *    conformidade — a menos que já exista uma ABERTA para o mesmo par
 *    (equipamento + item), caso em que a duplicata é ignorada e o app é
 *    avisado de quais itens foram pulados.
 */
function criarChecklist_(p) {
  const unidade = exigirUnidade_(p.unidade);
  validarAcessoUnidade_(p.idUsuario, unidade);

  const equipamento = equipamentoDaUnidade_(p.idEquipamento, unidade);
  const responsavel = textoLimpo_(p.responsavel);
  if (!responsavel) throw new Error('Selecione o responsável pelo checklist.');

  const itens = Array.isArray(p.itens) ? p.itens : [];
  if (!itens.length) throw new Error('Nenhum item respondido no checklist.');

  // Validação item a item ANTES de gravar qualquer coisa — assim um
  // checklist incompleto nunca deixa linhas soltas na planilha.
  itens.forEach(function (item) {
    const nome = textoLimpo_(item.item);
    if (!nome) throw new Error('Um dos itens do checklist está sem nome.');
    const resposta = textoLimpo_(item.resposta).toLowerCase();
    if (RESPOSTAS_CHECKLIST.indexOf(resposta) === -1) {
      throw new Error('Responda "' + nome + '" com OK, NOK ou N/A.');
    }
    if (resposta === 'nok') {
      if (!textoLimpo_(item.descricaoProblema)) {
        throw new Error('Descreva o problema do item "' + nome + '".');
      }
      if (!item.fotoProblema) {
        throw new Error('Anexe a foto do problema do item "' + nome + '".');
      }
    }
  });

  if (!p.fotoEquipamento) throw new Error('A foto do equipamento é obrigatória para concluir o checklist.');

  const idChecklist = nextId_('CHK');
  const agora = nowIso_();
  const temPendencia = itens.some(function (i) { return textoLimpo_(i.resposta).toLowerCase() === 'nok'; });
  const fotoEquipamento = salvarFoto_(p.fotoEquipamento, idChecklist + '_equipamento');
  if (!fotoEquipamento) throw new Error('Não foi possível salvar a foto do equipamento. Tente novamente.');

  appendRow_(SHEETS.CHECKLISTS, {
    ID_CHECKLIST: idChecklist,
    UNIDADE: unidade,
    ID_EQUIPAMENTO: equipamento.ID_EQUIPAMENTO,
    NOME_EQUIPAMENTO: equipamento.NOME,
    RESPONSAVEL: responsavel,
    DATA_HORA: agora,
    STATUS: temPendencia ? 'pendencia' : 'ok',
    FOTO_EQUIPAMENTO: fotoEquipamento
  });

  // Mapa das NCs já abertas: chave equipamento + item (a regra de
  // deduplicação pedida — só nasce outra depois que a anterior fechar).
  const abertas = {};
  readSheet_(SHEETS.NAO_CONFORMIDADES).forEach(function (nc) {
    if (String(nc.STATUS) === 'aberta') {
      abertas[String(nc.ID_EQUIPAMENTO) + '||' + textoLimpo_(nc.ITEM).toLowerCase()] = nc.ID_NC;
    }
  });

  const linhasItens = [];
  const ncCriadas = [];
  const ncIgnoradas = [];
  const idsItens = nextIds_('ITR', itens.length);

  itens.forEach(function (item, indice) {
    const nome = textoLimpo_(item.item);
    const resposta = textoLimpo_(item.resposta).toLowerCase();
    const instrucao = textoLimpo_(item.instrucao) || instrucaoPadraoDoItem_(nome);
    const descricao = resposta === 'nok' ? textoLimpo_(item.descricaoProblema) : '';
    const fotoProblema = resposta === 'nok'
      ? salvarFoto_(item.fotoProblema, idChecklist + '_' + nome.replace(/[^\wÀ-ú]+/g, '_'))
      : '';

    linhasItens.push({
      ID_ITEM_RESPOSTA: idsItens[indice],
      ID_CHECKLIST: idChecklist,
      ITEM: nome,
      INSTRUCAO: instrucao,
      RESPOSTA: resposta,
      DESCRICAO_PROBLEMA: descricao,
      FOTO_PROBLEMA: fotoProblema
    });

    if (resposta !== 'nok') return;

    const chave = String(equipamento.ID_EQUIPAMENTO) + '||' + nome.toLowerCase();
    if (abertas[chave]) {
      ncIgnoradas.push({ item: nome, idNcExistente: abertas[chave] });
      return;
    }
    const idNc = nextId_('NC');
    appendRow_(SHEETS.NAO_CONFORMIDADES, {
      ID_NC: idNc,
      UNIDADE: unidade,
      ID_EQUIPAMENTO: equipamento.ID_EQUIPAMENTO,
      NOME_EQUIPAMENTO: equipamento.NOME,
      ITEM: nome,
      DESCRICAO: descricao,
      FOTO: fotoProblema,
      STATUS: 'aberta',
      ABERTA_EM: agora,
      FECHADA_EM: '',
      ID_CHECKLIST_ORIGEM: idChecklist
    });
    abertas[chave] = idNc;
    ncCriadas.push({ item: nome, idNc: idNc });
  });

  appendRows_(SHEETS.CHECKLIST_ITENS, linhasItens);

  return {
    ok: true,
    data: {
      idChecklist: idChecklist,
      status: temPendencia ? 'pendencia' : 'ok',
      dataHora: agora,
      naoConformidadesCriadas: ncCriadas,
      naoConformidadesIgnoradas: ncIgnoradas
    }
  };
}

function instrucaoPadraoDoItem_(nomeItem) {
  const achado = CHECKLIST_ITENS_PADRAO.find(function (i) {
    return i.item.toLowerCase() === String(nomeItem).toLowerCase();
  });
  return achado ? achado.instrucao : '';
}

// ======================= NÃO CONFORMIDADES =======================

// Não existe criação manual: uma NC só nasce de um item NOK do checklist
// (ver criarChecklist_). Aqui só se consulta e se abre/fecha.
// filtros aceitos: status ('aberta'/'fechada'), idEquipamento, item,
// periodo + dataInicio/dataFim (aplicado sobre ABERTA_EM).
function getNaoConformidades_(params) {
  const janela = resolverPeriodo_(Object.assign({ periodo: params.periodo || 'todos' }, params));
  let rows = filtrarPorUnidade_(readSheet_(SHEETS.NAO_CONFORMIDADES), params.unidade);

  const status = textoLimpo_(params.status);
  if (status) rows = rows.filter(function (nc) { return String(nc.STATUS) === status; });

  const idEquipamento = textoLimpo_(params.idEquipamento);
  if (idEquipamento) rows = rows.filter(function (nc) { return String(nc.ID_EQUIPAMENTO) === idEquipamento; });

  const item = textoLimpo_(params.item);
  if (item) rows = rows.filter(function (nc) { return String(nc.ITEM) === item; });

  rows = rows.filter(function (nc) { return dentroDoPeriodo_(nc.ABERTA_EM, janela); });

  const agora = new Date();
  rows.forEach(function (nc) {
    const abertura = parseData_(nc.ABERTA_EM);
    const fechamento = parseData_(nc.FECHADA_EM);
    const fim = fechamento || agora;
    const ms = abertura ? Math.max(0, fim.getTime() - abertura.getTime()) : 0;
    nc.TEMPO_ABERTA_MS = ms;
    nc.TEMPO_ABERTA_TEXTO = abertura ? formatarDuracao_(ms) : '-';
  });

  return rows.sort(function (a, b) { return ordenarPorDataDesc_(a.ABERTA_EM, b.ABERTA_EM); });
}

// status: 'fechada' fecha (carimba FECHADA_EM); 'aberta' reabre (limpa).
function atualizarStatusNaoConformidade_(p) {
  const id = textoLimpo_(p.idNc);
  if (!id) throw new Error('Informe a não conformidade.');
  const status = textoLimpo_(p.status).toLowerCase();
  if (['aberta', 'fechada'].indexOf(status) === -1) {
    throw new Error('Status inválido: ' + status + '. Use aberta ou fechada.');
  }
  const atual = findRowById_(SHEETS.NAO_CONFORMIDADES, 'ID_NC', id);
  if (!atual) throw new Error('Não conformidade não encontrada.');
  validarAcessoUnidade_(p.idUsuario, atual.UNIDADE);

  // Reabrir só pode se não houver outra aberta para o mesmo equipamento +
  // item — senão a regra de "uma aberta por vez" seria furada por aqui.
  if (status === 'aberta' && String(atual.STATUS) !== 'aberta') {
    const conflito = readSheet_(SHEETS.NAO_CONFORMIDADES).find(function (nc) {
      return String(nc.ID_NC) !== id && String(nc.STATUS) === 'aberta' &&
        String(nc.ID_EQUIPAMENTO) === String(atual.ID_EQUIPAMENTO) &&
        textoLimpo_(nc.ITEM).toLowerCase() === textoLimpo_(atual.ITEM).toLowerCase();
    });
    if (conflito) {
      throw new Error('Já existe uma não conformidade aberta (' + conflito.ID_NC + ') para este equipamento e item.');
    }
  }

  const updates = status === 'fechada'
    ? { STATUS: 'fechada', FECHADA_EM: normalizarDataIso_(p.fechadaEm) || nowIso_() }
    : { STATUS: 'aberta', FECHADA_EM: '' };

  updateRowById_(SHEETS.NAO_CONFORMIDADES, 'ID_NC', id, updates);
  return { ok: true, data: findRowById_(SHEETS.NAO_CONFORMIDADES, 'ID_NC', id) };
}

// ======================= MANUTENÇÕES =======================

// filtros aceitos: status, tipo, prioridade, idEquipamento,
// periodo + dataInicio/dataFim (aplicado sobre ABERTA_EM).
function getManutencoes_(params) {
  const janela = resolverPeriodo_(Object.assign({ periodo: params.periodo || 'todos' }, params));
  let rows = filtrarPorUnidade_(readSheet_(SHEETS.MANUTENCOES), params.unidade);

  const status = textoLimpo_(params.status);
  if (status) rows = rows.filter(function (m) { return String(m.STATUS) === status; });

  const tipo = textoLimpo_(params.tipo);
  if (tipo) rows = rows.filter(function (m) { return String(m.TIPO) === tipo; });

  const prioridade = textoLimpo_(params.prioridade);
  if (prioridade) rows = rows.filter(function (m) { return String(m.PRIORIDADE) === prioridade; });

  const idEquipamento = textoLimpo_(params.idEquipamento);
  if (idEquipamento) rows = rows.filter(function (m) { return String(m.ID_EQUIPAMENTO) === idEquipamento; });

  rows = rows.filter(function (m) { return dentroDoPeriodo_(m.ABERTA_EM, janela); });

  rows.forEach(function (m) {
    const ms = tempoEmManutencaoMs_(m, null);
    m.TEMPO_MANUTENCAO_MS = ms;
    m.TEMPO_MANUTENCAO_TEXTO = formatarDuracao_(ms);
  });

  return rows.sort(function (a, b) { return ordenarPorDataDesc_(a.ABERTA_EM, b.ABERTA_EM); });
}

/**
 * Tempo em manutenção = CONCLUIDA_EM − (INICIADA_EM ou ABERTA_EM); se ainda
 * não foi concluída, conta até agora. Quando `janela` é informada, o
 * intervalo é recortado dentro do período pedido — assim o ranking do
 * relatório mostra o tempo daquele período, não o tempo total histórico.
 */
function tempoEmManutencaoMs_(manutencao, janela) {
  const inicio = parseData_(manutencao.INICIADA_EM) || parseData_(manutencao.ABERTA_EM);
  if (!inicio) return 0;
  const fim = parseData_(manutencao.CONCLUIDA_EM) || new Date();

  let de = inicio.getTime();
  let ate = fim.getTime();
  if (janela && janela.inicio) de = Math.max(de, janela.inicio.getTime());
  if (janela && janela.fim) ate = Math.min(ate, janela.fim.getTime());
  return Math.max(0, ate - de);
}

function criarManutencao_(p) {
  const unidade = exigirUnidade_(p.unidade);
  validarAcessoUnidade_(p.idUsuario, unidade);
  const equipamento = equipamentoDaUnidade_(p.idEquipamento, unidade);

  const tipo = textoLimpo_(p.tipo).toLowerCase() || 'corretiva';
  if (['corretiva', 'preventiva'].indexOf(tipo) === -1) {
    throw new Error('Tipo inválido: ' + tipo + '. Use corretiva ou preventiva.');
  }
  const prioridade = textoLimpo_(p.prioridade).toLowerCase() || 'media';
  if (['baixa', 'media', 'alta'].indexOf(prioridade) === -1) {
    throw new Error('Prioridade inválida: ' + prioridade + '. Use baixa, media ou alta.');
  }
  const titulo = textoLimpo_(p.titulo);
  if (!titulo) throw new Error('Informe o título da manutenção.');

  const status = textoLimpo_(p.status).toLowerCase() || 'aberta';
  if (['aberta', 'andamento', 'concluida'].indexOf(status) === -1) {
    throw new Error('Status inválido: ' + status + '. Use aberta, andamento ou concluida.');
  }

  const dataPrevista = tipo === 'preventiva' ? normalizarDataIso_(p.dataPrevista) : '';
  if (tipo === 'preventiva' && !dataPrevista) {
    throw new Error('Informe a data prevista da manutenção preventiva.');
  }

  const agora = nowIso_();
  const idManutencao = nextId_('MAN');
  const registro = {
    ID_MANUTENCAO: idManutencao,
    UNIDADE: unidade,
    ID_EQUIPAMENTO: equipamento.ID_EQUIPAMENTO,
    NOME_EQUIPAMENTO: equipamento.NOME,
    TIPO: tipo,
    PRIORIDADE: prioridade,
    TITULO: titulo,
    DESCRICAO: textoLimpo_(p.descricao),
    STATUS: status,
    DATA_PREVISTA: dataPrevista,
    ABERTA_EM: agora,
    INICIADA_EM: status === 'andamento' || status === 'concluida' ? (normalizarDataIso_(p.iniciadaEm) || agora) : '',
    CONCLUIDA_EM: status === 'concluida' ? (normalizarDataIso_(p.concluidaEm) || agora) : ''
  };
  appendRow_(SHEETS.MANUTENCOES, registro);
  return { ok: true, data: registro };
}

// A mudança de status controla sozinha INICIADA_EM e CONCLUIDA_EM:
// virou "andamento" → carimba o início; virou "concluída" → carimba a
// conclusão (e o início, se a manutenção pulou direto de aberta p/ concluída);
// voltou para "aberta"/"andamento" → limpa o carimbo que deixou de valer.
function atualizarManutencao_(p) {
  const id = textoLimpo_(p.idManutencao);
  if (!id) throw new Error('Informe a manutenção a atualizar.');
  const atual = findRowById_(SHEETS.MANUTENCOES, 'ID_MANUTENCAO', id);
  if (!atual) throw new Error('Manutenção não encontrada.');
  validarAcessoUnidade_(p.idUsuario, atual.UNIDADE);

  const updates = {};
  if (p.titulo !== undefined) {
    const titulo = textoLimpo_(p.titulo);
    if (!titulo) throw new Error('O título da manutenção não pode ficar em branco.');
    updates.TITULO = titulo;
  }
  if (p.descricao !== undefined) updates.DESCRICAO = textoLimpo_(p.descricao);

  if (p.tipo !== undefined) {
    const tipo = textoLimpo_(p.tipo).toLowerCase();
    if (['corretiva', 'preventiva'].indexOf(tipo) === -1) {
      throw new Error('Tipo inválido: ' + tipo + '. Use corretiva ou preventiva.');
    }
    updates.TIPO = tipo;
    if (tipo === 'corretiva') updates.DATA_PREVISTA = '';
  }
  if (p.prioridade !== undefined) {
    const prioridade = textoLimpo_(p.prioridade).toLowerCase();
    if (['baixa', 'media', 'alta'].indexOf(prioridade) === -1) {
      throw new Error('Prioridade inválida: ' + prioridade + '. Use baixa, media ou alta.');
    }
    updates.PRIORIDADE = prioridade;
  }
  if (p.dataPrevista !== undefined) {
    const tipoFinal = updates.TIPO || String(atual.TIPO);
    updates.DATA_PREVISTA = tipoFinal === 'preventiva' ? normalizarDataIso_(p.dataPrevista) : '';
  }

  if (p.status !== undefined) {
    const status = textoLimpo_(p.status).toLowerCase();
    if (['aberta', 'andamento', 'concluida'].indexOf(status) === -1) {
      throw new Error('Status inválido: ' + status + '. Use aberta, andamento ou concluida.');
    }
    updates.STATUS = status;
    const agora = nowIso_();
    const iniciadaAtual = normalizarDataIso_(atual.INICIADA_EM);

    if (status === 'aberta') {
      updates.INICIADA_EM = '';
      updates.CONCLUIDA_EM = '';
    } else if (status === 'andamento') {
      updates.INICIADA_EM = normalizarDataIso_(p.iniciadaEm) || iniciadaAtual || agora;
      updates.CONCLUIDA_EM = '';
    } else {
      updates.INICIADA_EM = normalizarDataIso_(p.iniciadaEm) || iniciadaAtual || normalizarDataIso_(atual.ABERTA_EM) || agora;
      updates.CONCLUIDA_EM = normalizarDataIso_(p.concluidaEm) || normalizarDataIso_(atual.CONCLUIDA_EM) || agora;
    }
  } else {
    // Correção manual de data sem trocar o status.
    if (p.iniciadaEm !== undefined) updates.INICIADA_EM = normalizarDataIso_(p.iniciadaEm);
    if (p.concluidaEm !== undefined) updates.CONCLUIDA_EM = normalizarDataIso_(p.concluidaEm);
  }

  updateRowById_(SHEETS.MANUTENCOES, 'ID_MANUTENCAO', id, updates);
  const atualizada = findRowById_(SHEETS.MANUTENCOES, 'ID_MANUTENCAO', id);
  atualizada.TEMPO_MANUTENCAO_MS = tempoEmManutencaoMs_(atualizada, null);
  atualizada.TEMPO_MANUTENCAO_TEXTO = formatarDuracao_(atualizada.TEMPO_MANUTENCAO_MS);
  return { ok: true, data: atualizada };
}

function ordenarPorDataDesc_(a, b) {
  const da = parseData_(a);
  const db = parseData_(b);
  return (db ? db.getTime() : 0) - (da ? da.getTime() : 0);
}

// ======================= PAINEL =======================

/**
 * Painel da unidade (ou consolidado, com unidade = 'TODAS'):
 *  - contagem de equipamentos por status;
 *  - quem está em manutenção agora;
 *  - preventivas previstas para os próximos 30 dias;
 *  - checklist de hoje, equipamento por equipamento (feito x pendente).
 */
function getPainel_(params) {
  const unidade = params.unidade;
  const agora = new Date();
  const hoje = inicioDoDia_(agora);
  const limitePreventiva = fimDoDia_(new Date(agora.getTime() + 30 * 86400000));

  const equipamentos = filtrarPorUnidade_(readSheet_(SHEETS.EQUIPAMENTOS), unidade);
  const ativos = equipamentos.filter(function (e) { return String(e.STATUS) !== 'inativo'; });
  const manutencoes = filtrarPorUnidade_(readSheet_(SHEETS.MANUTENCOES), unidade);
  const checklists = filtrarPorUnidade_(readSheet_(SHEETS.CHECKLISTS), unidade);
  const ncs = filtrarPorUnidade_(readSheet_(SHEETS.NAO_CONFORMIDADES), unidade);

  const totais = { em_uso: 0, manutencao: 0, parado: 0, inativo: 0 };
  equipamentos.forEach(function (e) {
    const s = String(e.STATUS);
    if (totais[s] !== undefined) totais[s]++;
  });

  const porTipo = agruparContagem_(ativos, 'TIPO');

  const equipamentosEmManutencao = equipamentos
    .filter(function (e) { return String(e.STATUS) === 'manutencao'; })
    .map(function (e) {
      const desde = parseData_(e.STATUS_DESDE) || parseData_(e.CRIADO_EM);
      const ms = desde ? Math.max(0, agora.getTime() - desde.getTime()) : 0;
      const emAberto = manutencoes.filter(function (m) {
        return String(m.ID_EQUIPAMENTO) === String(e.ID_EQUIPAMENTO) && String(m.STATUS) !== 'concluida';
      });
      return {
        ID_EQUIPAMENTO: e.ID_EQUIPAMENTO, NOME: e.NOME, CODIGO: e.CODIGO,
        TIPO: e.TIPO, UNIDADE: e.UNIDADE, STATUS_DESDE: e.STATUS_DESDE,
        TEMPO_MS: ms, TEMPO_TEXTO: desde ? formatarDuracao_(ms) : '-',
        MANUTENCOES_ABERTAS: emAberto.length,
        TITULO_ATUAL: emAberto.length ? emAberto[0].TITULO : ''
      };
    })
    .sort(function (a, b) { return b.TEMPO_MS - a.TEMPO_MS; });

  const preventivasProximas = manutencoes
    .filter(function (m) {
      if (String(m.TIPO) !== 'preventiva' || String(m.STATUS) === 'concluida') return false;
      const prevista = parseData_(m.DATA_PREVISTA);
      return !!prevista && prevista <= limitePreventiva;
    })
    .map(function (m) {
      const prevista = parseData_(m.DATA_PREVISTA);
      const diasRestantes = Math.ceil((inicioDoDia_(prevista).getTime() - hoje.getTime()) / 86400000);
      return {
        ID_MANUTENCAO: m.ID_MANUTENCAO, ID_EQUIPAMENTO: m.ID_EQUIPAMENTO,
        NOME_EQUIPAMENTO: m.NOME_EQUIPAMENTO, UNIDADE: m.UNIDADE,
        TITULO: m.TITULO, PRIORIDADE: m.PRIORIDADE, STATUS: m.STATUS,
        DATA_PREVISTA: m.DATA_PREVISTA, DIAS_RESTANTES: diasRestantes,
        ATRASADA: diasRestantes < 0
      };
    })
    .sort(function (a, b) { return a.DIAS_RESTANTES - b.DIAS_RESTANTES; });

  // Checklist do dia: para cada equipamento ativo, se já houve checklist hoje.
  const checklistsHoje = checklists.filter(function (c) {
    const d = parseData_(c.DATA_HORA);
    return !!d && mesmoDia_(d, agora);
  });
  const feitosHoje = {};
  checklistsHoje.forEach(function (c) {
    const chave = String(c.ID_EQUIPAMENTO);
    // Vale o mais recente do dia.
    if (!feitosHoje[chave] || ordenarPorDataDesc_(c.DATA_HORA, feitosHoje[chave].DATA_HORA) < 0) {
      feitosHoje[chave] = c;
    }
  });

  const checklistDoDia = ativos.map(function (e) {
    const c = feitosHoje[String(e.ID_EQUIPAMENTO)];
    return {
      ID_EQUIPAMENTO: e.ID_EQUIPAMENTO, NOME: e.NOME, CODIGO: e.CODIGO,
      TIPO: e.TIPO, UNIDADE: e.UNIDADE, STATUS_EQUIPAMENTO: e.STATUS,
      FEITO: !!c,
      ID_CHECKLIST: c ? c.ID_CHECKLIST : '',
      STATUS_CHECKLIST: c ? c.STATUS : '',
      RESPONSAVEL: c ? c.RESPONSAVEL : '',
      DATA_HORA: c ? c.DATA_HORA : ''
    };
  }).sort(function (a, b) {
    if (a.FEITO !== b.FEITO) return a.FEITO ? 1 : -1; // pendentes primeiro
    return String(a.NOME).localeCompare(String(b.NOME));
  });

  const feitos = checklistDoDia.filter(function (c) { return c.FEITO; }).length;

  return {
    unidade: ehTodasUnidades_(unidade) ? 'TODAS' : unidade,
    geradoEm: nowIso_(),
    totais: {
      total: equipamentos.length,
      ativos: ativos.length,
      em_uso: totais.em_uso,
      manutencao: totais.manutencao,
      parado: totais.parado,
      inativo: totais.inativo
    },
    porTipo: porTipo,
    indicadores: {
      totalEquipamentos: equipamentos.length,
      emFuncionamento: totais.em_uso,
      parados: totais.parado,
      emManutencao: totais.manutencao,
      inativos: totais.inativo,
      checklistsHoje: checklistsHoje.length,
      naoConformidadesAbertas: ncs.filter(function (n) { return String(n.STATUS) === 'aberta'; }).length,
      manutencoesAbertas: manutencoes.filter(function (m) { return String(m.STATUS) === 'aberta'; }).length,
      manutencoesAndamento: manutencoes.filter(function (m) { return String(m.STATUS) === 'andamento'; }).length,
      manutencoesConcluidas: manutencoes.filter(function (m) { return String(m.STATUS) === 'concluida'; }).length,
      preventivasRealizadas: manutencoes.filter(function (m) {
        return String(m.TIPO) === 'preventiva' && String(m.STATUS) === 'concluida';
      }).length
    },
    equipamentosEmManutencao: equipamentosEmManutencao,
    preventivasProximas: preventivasProximas,
    checklistDoDia: checklistDoDia,
    checklistDoDiaResumo: { total: checklistDoDia.length, feitos: feitos, pendentes: checklistDoDia.length - feitos }
  };
}

// ======================= HISTÓRICO =======================

// Linha do tempo unificada (checklists + manutenções + não conformidades),
// da mais recente para a mais antiga.
function getHistorico_(params) {
  const janela = resolverPeriodo_(Object.assign({ periodo: params.periodo || 'mes' }, params));
  const idEquipamento = textoLimpo_(params.idEquipamento);
  const tipoFiltro = textoLimpo_(params.tipo).toLowerCase(); // checklist | manutencao | nao_conformidade

  const eventos = [];

  const casaEquipamento = function (r) {
    return !idEquipamento || String(r.ID_EQUIPAMENTO) === idEquipamento;
  };

  if (!tipoFiltro || tipoFiltro === 'checklist') {
    filtrarPorUnidade_(readSheet_(SHEETS.CHECKLISTS), params.unidade)
      .filter(casaEquipamento)
      .filter(function (c) { return dentroDoPeriodo_(c.DATA_HORA, janela); })
      .forEach(function (c) {
        eventos.push({
          tipo: 'checklist',
          id: c.ID_CHECKLIST,
          data: normalizarDataIso_(c.DATA_HORA),
          unidade: c.UNIDADE,
          idEquipamento: c.ID_EQUIPAMENTO,
          nomeEquipamento: c.NOME_EQUIPAMENTO,
          titulo: 'Checklist ' + (String(c.STATUS) === 'pendencia' ? 'com pendência' : 'sem pendência'),
          descricao: 'Responsável: ' + (c.RESPONSAVEL || '-'),
          status: c.STATUS,
          responsavel: c.RESPONSAVEL,
          foto: c.FOTO_EQUIPAMENTO
        });
      });
  }

  if (!tipoFiltro || tipoFiltro === 'manutencao') {
    filtrarPorUnidade_(readSheet_(SHEETS.MANUTENCOES), params.unidade)
      .filter(casaEquipamento)
      .filter(function (m) { return dentroDoPeriodo_(m.ABERTA_EM, janela); })
      .forEach(function (m) {
        eventos.push({
          tipo: 'manutencao',
          id: m.ID_MANUTENCAO,
          data: normalizarDataIso_(m.ABERTA_EM),
          unidade: m.UNIDADE,
          idEquipamento: m.ID_EQUIPAMENTO,
          nomeEquipamento: m.NOME_EQUIPAMENTO,
          titulo: m.TITULO,
          descricao: m.DESCRICAO,
          status: m.STATUS,
          tipoManutencao: m.TIPO,
          prioridade: m.PRIORIDADE,
          dataPrevista: normalizarDataIso_(m.DATA_PREVISTA),
          iniciadaEm: normalizarDataIso_(m.INICIADA_EM),
          concluidaEm: normalizarDataIso_(m.CONCLUIDA_EM),
          tempoTexto: formatarDuracao_(tempoEmManutencaoMs_(m, null))
        });
      });
  }

  if (!tipoFiltro || tipoFiltro === 'nao_conformidade') {
    filtrarPorUnidade_(readSheet_(SHEETS.NAO_CONFORMIDADES), params.unidade)
      .filter(casaEquipamento)
      .filter(function (nc) { return dentroDoPeriodo_(nc.ABERTA_EM, janela); })
      .forEach(function (nc) {
        eventos.push({
          tipo: 'nao_conformidade',
          id: nc.ID_NC,
          data: normalizarDataIso_(nc.ABERTA_EM),
          unidade: nc.UNIDADE,
          idEquipamento: nc.ID_EQUIPAMENTO,
          nomeEquipamento: nc.NOME_EQUIPAMENTO,
          titulo: 'Não conformidade: ' + nc.ITEM,
          descricao: nc.DESCRICAO,
          status: nc.STATUS,
          item: nc.ITEM,
          foto: nc.FOTO,
          fechadaEm: normalizarDataIso_(nc.FECHADA_EM),
          idChecklistOrigem: nc.ID_CHECKLIST_ORIGEM
        });
      });
  }

  eventos.sort(function (a, b) { return ordenarPorDataDesc_(a.data, b.data); });

  return {
    unidade: ehTodasUnidades_(params.unidade) ? 'TODAS' : params.unidade,
    periodo: { tipo: janela.tipo, label: janela.label, inicio: janela.inicio ? toIso_(janela.inicio) : '', fim: janela.fim ? toIso_(janela.fim) : '' },
    total: eventos.length,
    eventos: eventos
  };
}

// ======================= RELATÓRIO (indicadores) =======================

/**
 * Indicadores do período + dados prontos para o gráfico, o ranking e a
 * lista de equipamentos parados. É esta mesma função que alimenta o PDF —
 * assim a tela e o relatório impresso nunca divergem.
 *
 * Atenção: "equipamentos parados agora" é ESTADO ATUAL, então não recebe
 * filtro de período — é sempre a foto do momento.
 */
function getRelatorio_(params) {
  const janela = resolverPeriodo_(params);
  const unidade = params.unidade;
  const agora = new Date();

  const equipamentos = filtrarPorUnidade_(readSheet_(SHEETS.EQUIPAMENTOS), unidade);
  const equipamentosAtivos = equipamentos.filter(function (e) { return String(e.STATUS) !== 'inativo'; });

  const checklists = filtrarPorUnidade_(readSheet_(SHEETS.CHECKLISTS), unidade)
    .filter(function (c) { return dentroDoPeriodo_(c.DATA_HORA, janela); });

  const manutencoesUnidade = filtrarPorUnidade_(readSheet_(SHEETS.MANUTENCOES), unidade);
  const manutencoes = manutencoesUnidade.filter(function (m) { return dentroDoPeriodo_(m.ABERTA_EM, janela); });

  const ncs = filtrarPorUnidade_(readSheet_(SHEETS.NAO_CONFORMIDADES), unidade)
    .filter(function (nc) { return dentroDoPeriodo_(nc.ABERTA_EM, janela); });

  const manutencoesAbertas = manutencoes.filter(function (m) { return String(m.STATUS) === 'aberta'; }).length;
  const manutencoesAndamento = manutencoes.filter(function (m) { return String(m.STATUS) === 'andamento'; }).length;
  const manutencoesConcluidas = manutencoes.filter(function (m) { return String(m.STATUS) === 'concluida'; }).length;

  // ---- Ranking: equipamentos com mais tempo acumulado em manutenção ----
  // Considera manutenções em andamento e concluídas cujo intervalo cruza a
  // janela do período; o tempo é recortado dentro da janela.
  const rankingMap = {};
  manutencoesUnidade.forEach(function (m) {
    if (String(m.STATUS) === 'aberta') return; // ainda não começou a contar
    const inicio = parseData_(m.INICIADA_EM) || parseData_(m.ABERTA_EM);
    if (!inicio) return;
    const fim = parseData_(m.CONCLUIDA_EM) || agora;
    // Só entra no ranking a manutenção cujo intervalo encosta na janela do
    // período. Uma manutenção rápida (poucos minutos) continua aparecendo,
    // com tempo próximo de zero — o que não pode é sumir do relatório.
    if (janela.fim && inicio > janela.fim) return;
    if (janela.inicio && fim < janela.inicio) return;
    const ms = tempoEmManutencaoMs_(m, janela);
    const chave = String(m.ID_EQUIPAMENTO);
    if (!rankingMap[chave]) {
      rankingMap[chave] = {
        idEquipamento: m.ID_EQUIPAMENTO, nomeEquipamento: m.NOME_EQUIPAMENTO,
        unidade: m.UNIDADE, ms: 0, quantidade: 0
      };
    }
    rankingMap[chave].ms += ms;
    rankingMap[chave].quantidade++;
  });
  const ranking = Object.keys(rankingMap)
    .map(function (k) {
      const r = rankingMap[k];
      const equipamento = equipamentos.find(function (e) { return String(e.ID_EQUIPAMENTO) === String(r.idEquipamento); });
      return {
        idEquipamento: r.idEquipamento,
        nomeEquipamento: r.nomeEquipamento,
        codigo: equipamento ? equipamento.CODIGO : '',
        tipo: equipamento ? equipamento.TIPO : '',
        unidade: r.unidade,
        quantidadeManutencoes: r.quantidade,
        tempoMs: r.ms,
        tempoHoras: Math.round(r.ms / 360000) / 10,
        tempoTexto: formatarDuracao_(r.ms)
      };
    })
    .sort(function (a, b) { return b.tempoMs - a.tempoMs; });

  // ---- Equipamentos parados AGORA (estado atual, sem filtro de período) ----
  const parados = equipamentos
    .filter(function (e) { return String(e.STATUS) === 'parado'; })
    .map(function (e) {
      const desde = parseData_(e.STATUS_DESDE) || parseData_(e.CRIADO_EM);
      const ms = desde ? Math.max(0, agora.getTime() - desde.getTime()) : 0;
      return {
        idEquipamento: e.ID_EQUIPAMENTO, nomeEquipamento: e.NOME, codigo: e.CODIGO,
        tipo: e.TIPO, unidade: e.UNIDADE, statusDesde: normalizarDataIso_(e.STATUS_DESDE),
        tempoMs: ms, tempoTexto: desde ? formatarDuracao_(ms) : '-',
        observacoes: e.OBSERVACOES
      };
    })
    .sort(function (a, b) { return b.tempoMs - a.tempoMs; });

  // ---- Equipamentos em manutenção AGORA (mesma lógica, estado atual) ----
  const emManutencaoAgora = equipamentos
    .filter(function (e) { return String(e.STATUS) === 'manutencao'; })
    .map(function (e) {
      const desde = parseData_(e.STATUS_DESDE) || parseData_(e.CRIADO_EM);
      const ms = desde ? Math.max(0, agora.getTime() - desde.getTime()) : 0;
      return {
        idEquipamento: e.ID_EQUIPAMENTO, nomeEquipamento: e.NOME, codigo: e.CODIGO,
        tipo: e.TIPO, unidade: e.UNIDADE, statusDesde: normalizarDataIso_(e.STATUS_DESDE),
        tempoMs: ms, tempoTexto: desde ? formatarDuracao_(ms) : '-'
      };
    })
    .sort(function (a, b) { return b.tempoMs - a.tempoMs; });

  const statusFrota = { em_uso: 0, manutencao: 0, parado: 0, inativo: 0 };
  equipamentos.forEach(function (e) {
    const s = String(e.STATUS);
    if (statusFrota[s] !== undefined) statusFrota[s]++;
  });

  // Não conformidades mais recorrentes (por item) — insumo do plano de ação.
  const ncPorItem = agruparContagem_(ncs, 'ITEM');

  return {
    unidade: ehTodasUnidades_(unidade) ? 'TODAS' : unidade,
    geradoEm: nowIso_(),
    periodo: {
      tipo: janela.tipo,
      label: janela.label,
      inicio: janela.inicio ? toIso_(janela.inicio) : '',
      fim: janela.fim ? toIso_(janela.fim) : ''
    },
    indicadores: {
      totalEquipamentos: equipamentos.length,
      equipamentosAtivos: equipamentosAtivos.length,
      checklistsRealizados: checklists.length,
      checklistsComPendencia: checklists.filter(function (c) { return String(c.STATUS) === 'pendencia'; }).length,
      manutencoesAbertas: manutencoesAbertas,
      manutencoesAndamento: manutencoesAndamento,
      manutencoesConcluidas: manutencoesConcluidas,
      manutencoesTotal: manutencoes.length,
      manutencoesCorretivas: manutencoes.filter(function (m) { return String(m.TIPO) === 'corretiva'; }).length,
      manutencoesPreventivas: manutencoes.filter(function (m) { return String(m.TIPO) === 'preventiva'; }).length,
      naoConformidadesAbertas: ncs.filter(function (nc) { return String(nc.STATUS) === 'aberta'; }).length,
      naoConformidadesFechadas: ncs.filter(function (nc) { return String(nc.STATUS) === 'fechada'; }).length,
      equipamentosParadosAgora: parados.length,
      equipamentosEmManutencaoAgora: emManutencaoAgora.length
    },
    statusFrota: statusFrota,
    manutencoesPorStatus: {
      aberta: manutencoesAbertas,
      andamento: manutencoesAndamento,
      concluida: manutencoesConcluidas
    },
    // Pronto para desenhar o gráfico de barras (mesma ordem em todo lugar).
    graficoManutencoesPorStatus: {
      categorias: ['Abertas', 'Em andamento', 'Concluídas'],
      valores: [manutencoesAbertas, manutencoesAndamento, manutencoesConcluidas],
      cores: ['#D64545', '#DF8630', '#2F9E64']
    },
    graficoStatusFrota: {
      categorias: ['Em uso', 'Em manutenção', 'Parado', 'Inativo'],
      valores: [statusFrota.em_uso, statusFrota.manutencao, statusFrota.parado, statusFrota.inativo],
      cores: ['#2F9E64', '#DF8630', '#D64545', '#6b7280']
    },
    rankingTempoManutencao: ranking,
    equipamentosParados: parados,
    equipamentosEmManutencao: emManutencaoAgora,
    naoConformidadesPorItem: ncPorItem,
    naoConformidadesAbertasLista: ncs.filter(function (nc) { return String(nc.STATUS) === 'aberta'; }),
    // Registros do período, para a tabela detalhada e o CSV do frontend.
    manutencoes: manutencoes.map(function (m) {
      const ms = tempoEmManutencaoMs_(m, null);
      return Object.assign({}, m, { TEMPO_MANUTENCAO_MS: ms, TEMPO_MANUTENCAO_TEXTO: formatarDuracao_(ms) });
    }),
    checklists: checklists
  };
}

// ======================= RELATÓRIO EM PDF =======================
// Mesma técnica do app de referência: cada seção do relatório é um slide do
// Google Slides (o Slides aceita imagem de fundo, o Docs não), com o fundo
// oficial da ICC Brazil embutido em base64 neste próprio arquivo, gráficos
// gerados pelo serviço nativo Charts do Apps Script (sem nenhuma API
// externa) e, no fim, tudo exportado como um único PDF.

// Cria um slide já com o fundo texturizado oficial da ICC.
function slideNovo_(pres) {
  const slide = pres.appendSlide(SlidesApp.PredefinedLayout.BLANK);
  try {
    const bytes = Utilities.base64Decode(BG_CONTEUDO_BASE64);
    const blob = Utilities.newBlob(bytes, 'image/jpeg', 'bg.jpg');
    const img = slide.insertImage(blob, 0, 0, pres.getPageWidth(), pres.getPageHeight());
    img.sendToBack();
  } catch (e) { /* segue sem fundo se falhar */ }
  return slide;
}

function slideTitulo_(slide, texto, top, opts) {
  opts = opts || {};
  const box = slide.insertTextBox(texto, 40, top, opts.width || 620, opts.height || 40);
  box.getText().getTextStyle()
    .setBold(true)
    .setFontSize(opts.size || 22)
    .setForegroundColor(opts.color || '#436722');
  return box;
}

function slideTexto_(slide, texto, top, opts) {
  opts = opts || {};
  const box = slide.insertTextBox(texto, opts.left || 40, top, opts.width || 620, opts.height || 60);
  const style = box.getText().getTextStyle();
  style.setFontSize(opts.size || 11).setForegroundColor(opts.color || '#171b1e');
  if (opts.bold) style.setBold(true);
  if (opts.italic) style.setItalic(true);
  return box;
}

function slideImagemCentralizada_(slide, blob, top, larguraMax, pres, alturaMax) {
  if (!blob) return null;
  const img = slide.insertImage(blob);
  let escala = larguraMax / img.getWidth();
  if (alturaMax && img.getHeight() * escala > alturaMax) escala = alturaMax / img.getHeight();
  img.setWidth(img.getWidth() * escala);
  img.setHeight(img.getHeight() * escala);
  img.setLeft((pres.getPageWidth() - img.getWidth()) / 2);
  img.setTop(top);
  return img;
}

function slideTabela_(slide, dados, top, opts) {
  opts = opts || {};
  const numRows = dados.length, numCols = dados[0].length;
  const largura = opts.width || 620;
  const altura = opts.height || (numRows * 26);
  const table = slide.insertTable(numRows, numCols, 40, top, largura, altura);
  for (let r = 0; r < numRows; r++) {
    for (let c = 0; c < numCols; c++) {
      const cell = table.getCell(r, c);
      const isHeader = r === 0;
      cell.getFill().setSolidFill(isHeader ? '#436722' : (r % 2 === 0 ? '#F7F8F6' : '#FFFFFF'));
      const txt = cell.getText();
      txt.setText(String(dados[r][c]));
      const st = txt.getTextStyle().setFontSize(opts.fontSize || 10).setForegroundColor(isHeader ? '#FFFFFF' : '#171b1e');
      if (isHeader) st.setBold(true);
      if (opts.corColuna && opts.corColuna[c] && r > 0) {
        const cor = opts.corColuna[c](dados[r], r);
        if (cor) st.setForegroundColor(cor).setBold(true);
      }
    }
  }
  return table;
}

// Bloco de número em destaque (o "cartão" de KPI do relatório).
function slideBlocoKpi_(slide, left, top, largura, altura, valor, rotulo, corValor) {
  const box = slide.insertTextBox('', left, top, largura, altura);
  box.getFill().setSolidFill('#F4F5F3');
  box.getBorder().setTransparent();
  const tr = box.getText();
  const textoValor = String(valor);
  tr.setText(textoValor + '\n' + rotulo);
  tr.getRange(0, textoValor.length).getTextStyle()
    .setBold(true).setFontSize(altura >= 68 ? 22 : 18).setForegroundColor(corValor || '#171b1e');
  tr.getRange(textoValor.length + 1, tr.asString().length).getTextStyle()
    .setFontSize(8).setForegroundColor('#6b7280');
  return box;
}

// Gera um gráfico de barras (PNG) com o serviço nativo Charts do Apps
// Script — painel escuro, no mesmo padrão visual do relatório de referência.
function gerarGraficoBarras_(titulo, categorias, series, cores, largura) {
  if (!categorias || !categorias.length) return null;
  const w = largura || 560;
  const umaSerieSo = series.length === 1;

  // Com uma série só, o valor entra junto do rótulo ("Abertas (5)") — dá o
  // efeito de número em destaque sem depender de anotação no gráfico, que o
  // serviço de Charts do Apps Script não suporta.
  const categoriasExibidas = umaSerieSo
    ? categorias.map(function (cat, i) { return cat + '  (' + series[0].valores[i] + ')'; })
    : categorias;

  const dataTable = Charts.newDataTable();
  dataTable.addColumn(Charts.ColumnType.STRING, 'Categoria');
  series.forEach(function (s) { dataTable.addColumn(Charts.ColumnType.NUMBER, s.nome); });
  categoriasExibidas.forEach(function (cat, i) {
    dataTable.addRow([cat].concat(series.map(function (s) { return Number(s.valores[i] || 0); })));
  });

  let builder = Charts.newColumnChart()
    .setDataTable(dataTable.build())
    .setTitle(titulo)
    .setDimensions(w, 320)
    .setBackgroundColor('#1e1e1e')
    .setColors(cores)
    .setOption('titleTextStyle', { color: '#ffffff', fontSize: 15, bold: true })
    .setOption('hAxis', { textStyle: { color: '#e8e8e8', fontSize: 11, bold: true } })
    .setOption('vAxis', { textStyle: { color: '#1e1e1e' }, gridlines: { color: 'transparent' }, baselineColor: '#555555' })
    .setOption('bar', { groupWidth: umaSerieSo ? '45%' : '65%' })
    .setOption('backgroundColor', '#1e1e1e');

  if (umaSerieSo) {
    builder = builder.setOption('legend', { position: 'none' });
  } else {
    builder = builder.setLegendPosition(Charts.Position.BOTTOM)
      .setOption('legend', { position: 'bottom', textStyle: { color: '#ffffff', fontSize: 10 }, maxLines: 2 });
  }
  return builder.build().getAs('image/png');
}

// Classifica um indicador em Conforme/Atenção/Crítico por faixa de valor —
// limites = [limiteConforme, limiteAtencao]; acima disso é Crítico.
function severidade_(valor, limites) {
  if (valor <= limites[0]) return { label: 'Conforme', cor: '#2F9E64' };
  if (valor <= limites[1]) return { label: 'Atenção', cor: '#DF8630' };
  return { label: 'Crítico', cor: '#D64545' };
}

/**
 * Gera o PDF do relatório gerencial da Central de Frota e devolve
 * { base64, filename, url } — o base64 serve para o app baixar o arquivo
 * na hora, e a url é o link do PDF arquivado no Google Drive.
 *
 * Parâmetros: unidade ('TODAS' vale), periodo ('semana'|'mes'|'todos'|'custom'),
 * dataInicio, dataFim.
 */
function gerarRelatorioPDF_(p) {
  const r = getRelatorio_(p);
  const unidadeLabel = ehTodasUnidades_(p.unidade) ? 'Todas as unidades' : (p.unidade || '-');
  const ind = r.indicadores;

  const pres = SlidesApp.create('tmp_relatorio_frota_' + new Date().getTime());
  pres.getSlides()[0].remove(); // tira o slide em branco que o Slides cria sozinho
  const PW = pres.getPageWidth();
  const PH = pres.getPageHeight();

  const INK = '#171b1e', GRAY = '#6b7280', BRAND = '#5e9030', BRAND_DARK = '#436722';
  const VERDE = '#2F9E64', LARANJA = '#DF8630', VERMELHO = '#D64545';

  let slide;

  // ---------- Slide 1: capa ----------
  slide = slideNovo_(pres);
  try {
    const logoBytes = Utilities.base64Decode(LOGO_ICC_BASE64);
    const logoBlob = Utilities.newBlob(logoBytes, 'image/png', 'logo.png');
    const logo = slide.insertImage(logoBlob, 40, 40, 62, 62);
    logo.setLeft(40).setTop(40);
  } catch (e) { /* segue sem a logo se falhar */ }
  slideTitulo_(slide, 'ICC BRAZIL', 128, { size: 16, color: BRAND_DARK, width: PW - 80 });
  slideTitulo_(slide, 'Central de Frota', 160, { size: 40, color: INK, width: PW - 80 });
  slideTitulo_(slide, 'Relatório gerencial de manutenção', 212, { size: 18, color: BRAND, width: PW - 80 });
  slideTexto_(slide, unidadeLabel + '   ·   ' + r.periodo.label, 246, { size: 13, color: INK, width: PW - 80 });
  slideTexto_(slide, 'Gerado em ' + formatarDataHoraBr_(r.geradoEm), 268, { size: 11, color: GRAY, width: PW - 80 });

  // ---------- Slide 2: sumário executivo + KPIs ----------
  slide = slideNovo_(pres);
  slideTitulo_(slide, 'Sumário executivo', 30, {});

  let sumario = 'No período analisado (' + r.periodo.label + '), a operação de ' + unidadeLabel +
    ' contava com ' + ind.totalEquipamentos + ' equipamento(s) cadastrado(s), sendo ' + r.statusFrota.em_uso +
    ' em uso, ' + r.statusFrota.manutencao + ' em manutenção e ' + r.statusFrota.parado + ' parado(s). ' +
    'Foram realizados ' + ind.checklistsRealizados + ' checklist(s), dos quais ' + ind.checklistsComPendencia +
    ' apontaram alguma pendência, e registradas ' + ind.manutencoesTotal + ' manutenção(ões) (' +
    ind.manutencoesConcluidas + ' já concluída(s)).';
  if (ind.naoConformidadesAbertas > 0) {
    sumario += ' Há ' + ind.naoConformidadesAbertas + ' não conformidade(s) em aberto aguardando tratamento.';
  } else {
    sumario += ' Não há não conformidades em aberto no período.';
  }
  if (r.rankingTempoManutencao.length) {
    const topo = r.rankingTempoManutencao[0];
    sumario += ' O equipamento com maior tempo acumulado em manutenção é ' + topo.nomeEquipamento +
      ' (' + topo.tempoTexto + ' em ' + topo.quantidadeManutencoes + ' manutenção(ões)).';
  }
  if (r.equipamentosParados.length) {
    const parado = r.equipamentosParados[0];
    sumario += ' Atenção: ' + r.equipamentosParados.length + ' equipamento(s) estão parados agora, com destaque para ' +
      parado.nomeEquipamento + ', parado há ' + parado.tempoTexto + '.';
  }
  slideTexto_(slide, sumario, 68, { size: 11, height: 120, width: PW - 80 });

  const kpis = [
    ['Equipamentos', ind.totalEquipamentos, INK],
    ['Checklists', ind.checklistsRealizados, INK],
    ['Manut. abertas', ind.manutencoesAbertas, VERMELHO],
    ['Em andamento', ind.manutencoesAndamento, LARANJA],
    ['Concluídas', ind.manutencoesConcluidas, VERDE],
    ['NC abertas', ind.naoConformidadesAbertas, VERMELHO]
  ];
  const kpiW = (PW - 80) / kpis.length - 6;
  let kx = 40;
  kpis.forEach(function (k) {
    slideBlocoKpi_(slide, kx, 205, kpiW, 70, k[1], k[0], k[2]);
    kx += kpiW + 6;
  });
  slideTexto_(slide,
    'Equipamentos parados agora: ' + ind.equipamentosParadosAgora +
    '   ·   Em manutenção agora: ' + ind.equipamentosEmManutencaoAgora +
    '   ·   Não conformidades encerradas no período: ' + ind.naoConformidadesFechadas,
    288, { size: 9.5, color: GRAY, italic: true, width: PW - 80, height: 20 });

  // ---------- Slide 3: leitura gerencial dos indicadores ----------
  slide = slideNovo_(pres);
  slideTitulo_(slide, 'Leitura gerencial dos indicadores', 30, {});
  slideTexto_(slide, 'Faixas de referência automáticas — devem ser revisadas pelo gestor antes de qualquer apresentação formal.', 66, { size: 10, color: GRAY, height: 22, width: PW - 80 });

  const indicadores = [
    ['Manutenções abertas', ind.manutencoesAbertas, [0, 3]],
    ['Manutenções em andamento', ind.manutencoesAndamento, [1, 4]],
    ['Não conformidades abertas', ind.naoConformidadesAbertas, [0, 3]],
    ['Checklists com pendência', ind.checklistsComPendencia, [0, 3]],
    ['Equipamentos parados agora', ind.equipamentosParadosAgora, [0, 2]],
    ['Equipamentos em manutenção agora', ind.equipamentosEmManutencaoAgora, [0, 2]]
  ];
  const linhasInd = [['Indicador', 'Quantidade', 'Status']].concat(indicadores.map(function (i) {
    return [i[0], String(i[1]), severidade_(i[1], i[2]).label];
  }));
  slideTabela_(slide, linhasInd, 100, {
    width: PW - 80, height: 30 * linhasInd.length,
    corColuna: {
      2: function (row) {
        const s = row[2];
        return s === 'Crítico' ? VERMELHO : (s === 'Atenção' ? LARANJA : VERDE);
      }
    }
  });

  // ---------- Slides de gráfico ----------
  function slideGrafico_(titulo, blob, nota, corNota) {
    if (!blob) return;
    const s = slideNovo_(pres);
    slideTitulo_(s, titulo, 30, {});
    const alturaDisponivel = PH - 80 - (nota ? 45 : 15);
    const img = slideImagemCentralizada_(s, blob, 80, PW - 160, pres, alturaDisponivel);
    if (nota && img) {
      slideTexto_(s, nota, img.getTop() + img.getHeight() + 12, { size: 11, color: corNota || INK, bold: true, width: PW - 80 });
    }
  }

  const g1 = r.graficoManutencoesPorStatus;
  if (g1.valores.some(function (v) { return v > 0; })) {
    try {
      const blob1 = gerarGraficoBarras_('Manutenções por status', g1.categorias,
        [{ nome: 'Manutenções', valores: g1.valores }], ['#3B82C4']);
      const pctConcluidas = ind.manutencoesTotal > 0
        ? Math.round(ind.manutencoesConcluidas / ind.manutencoesTotal * 100) : 0;
      slideGrafico_('Manutenções por status', blob1,
        ind.manutencoesTotal + ' manutenção(ões) no período — ' + pctConcluidas + '% já concluída(s).',
        pctConcluidas >= 70 ? VERDE : (pctConcluidas >= 40 ? LARANJA : VERMELHO));
    } catch (e) { /* gráfico é bônus: se falhar, o relatório continua */ }
  }

  const g2 = r.graficoStatusFrota;
  if (g2.valores.some(function (v) { return v > 0; })) {
    try {
      const blob2 = gerarGraficoBarras_('Situação atual da frota', g2.categorias,
        [{ nome: 'Equipamentos', valores: g2.valores }], ['#5e9030']);
      const disponiveis = ind.totalEquipamentos > 0
        ? Math.round(r.statusFrota.em_uso / ind.totalEquipamentos * 100) : 0;
      slideGrafico_('Situação atual da frota', blob2,
        disponiveis + '% da frota está em uso neste momento.',
        disponiveis >= 80 ? VERDE : (disponiveis >= 60 ? LARANJA : VERMELHO));
    } catch (e) { /* */ }
  }

  // ---------- Ranking de tempo em manutenção ----------
  if (r.rankingTempoManutencao.length) {
    slide = slideNovo_(pres);
    slideTitulo_(slide, 'Máquinas com mais tempo em manutenção', 30, {});
    slideTexto_(slide, 'Soma do tempo de cada equipamento em manutenção no período (manutenções concluídas e em andamento), da maior para a menor.', 66, { size: 10, color: GRAY, height: 26, width: PW - 80 });

    const topo = r.rankingTempoManutencao.slice(0, 8);
    const linhasRanking = [['#', 'Equipamento', 'Tipo', 'Manutenções', 'Tempo acumulado']].concat(
      topo.map(function (item, i) {
        return [String(i + 1), item.nomeEquipamento + (item.codigo ? ' (' + item.codigo + ')' : ''),
          item.tipo || '-', String(item.quantidadeManutencoes), item.tempoTexto];
      })
    );
    slideTabela_(slide, linhasRanking, 104, {
      width: PW - 80, height: 28 * linhasRanking.length,
      corColuna: { 4: function (row, i) { return i === 1 ? VERMELHO : null; } }
    });
    if (r.rankingTempoManutencao.length > topo.length) {
      slideTexto_(slide, 'Mostrando os ' + topo.length + ' primeiros de ' + r.rankingTempoManutencao.length + ' equipamentos com registro no período.',
        104 + 28 * linhasRanking.length + 8, { size: 9, color: GRAY, italic: true, height: 16, width: PW - 80 });
    }
  }

  // ---------- Equipamentos parados agora ----------
  if (r.equipamentosParados.length) {
    slide = slideNovo_(pres);
    slideTitulo_(slide, 'Máquinas paradas agora', 30, {});
    slideTexto_(slide, 'Situação do momento (não depende do período selecionado). O tempo parado é contado desde a última mudança de status do equipamento.', 66, { size: 10, color: GRAY, height: 26, width: PW - 80 });

    const paradosTopo = r.equipamentosParados.slice(0, 8);
    const linhasParados = [['Equipamento', 'Tipo', 'Parado desde', 'Tempo parado']].concat(
      paradosTopo.map(function (e) {
        return [e.nomeEquipamento + (e.codigo ? ' (' + e.codigo + ')' : ''), e.tipo || '-',
          formatarDataHoraBr_(e.statusDesde), e.tempoTexto];
      })
    );
    slideTabela_(slide, linhasParados, 104, {
      width: PW - 80, height: 28 * linhasParados.length,
      corColuna: { 3: function () { return VERMELHO; } }
    });
  }

  // ---------- Não conformidades em aberto ----------
  if (r.naoConformidadesAbertasLista.length) {
    slide = slideNovo_(pres);
    slideTitulo_(slide, 'Não conformidades em aberto', 30, {});
    slideTexto_(slide, 'Abertas automaticamente a partir de itens reprovados (NOK) no checklist e ainda não encerradas.', 66, { size: 10, color: GRAY, height: 22, width: PW - 80 });

    const ncTopo = r.naoConformidadesAbertasLista.slice(0, 8);
    const linhasNc = [['Equipamento', 'Item', 'Aberta em', 'Descrição']].concat(
      ncTopo.map(function (nc) {
        const desc = String(nc.DESCRICAO || '-');
        return [nc.NOME_EQUIPAMENTO, nc.ITEM, formatarDataBr_(nc.ABERTA_EM),
          desc.length > 60 ? desc.slice(0, 57) + '...' : desc];
      })
    );
    slideTabela_(slide, linhasNc, 100, { width: PW - 80, height: 28 * linhasNc.length, fontSize: 9 });
    if (r.naoConformidadesAbertasLista.length > ncTopo.length) {
      slideTexto_(slide, 'Mostrando ' + ncTopo.length + ' de ' + r.naoConformidadesAbertasLista.length + ' não conformidades abertas.',
        100 + 28 * linhasNc.length + 8, { size: 9, color: GRAY, italic: true, height: 16, width: PW - 80 });
    }
  }

  // ---------- Plano de ação gerencial ----------
  const planoAcao = [];
  if (ind.naoConformidadesAbertas > 0) {
    planoAcao.push(['Tratar não conformidades em aberto', 'Alta', 'Encerrar os ' + ind.naoConformidadesAbertas + ' apontamento(s) pendente(s) do checklist.']);
  }
  if (ind.equipamentosParadosAgora > 0) {
    planoAcao.push(['Recolocar máquinas paradas em operação', 'Alta', 'Reduzir indisponibilidade de ' + ind.equipamentosParadosAgora + ' equipamento(s).']);
  }
  if (ind.manutencoesAbertas > 0) {
    planoAcao.push(['Iniciar manutenções ainda não começadas', 'Alta', ind.manutencoesAbertas + ' manutenção(ões) aguardando início.']);
  }
  if (ind.manutencoesAndamento > 0) {
    planoAcao.push(['Concluir manutenções em andamento', 'Média', 'Encerrar ' + ind.manutencoesAndamento + ' manutenção(ões) em execução.']);
  }
  if (ind.manutencoesPreventivas === 0) {
    planoAcao.push(['Programar manutenções preventivas', 'Média', 'Nenhuma preventiva registrada no período.']);
  }
  planoAcao.push(['Manter o checklist diário da frota', 'Média', 'Garantir detecção precoce de falhas antes da quebra.']);

  slide = slideNovo_(pres);
  slideTitulo_(slide, 'Plano de ação gerencial', 30, {});
  slideTabela_(slide, [['Ação', 'Prioridade', 'Objetivo']].concat(planoAcao), 80, {
    width: PW - 80, height: 30 * (planoAcao.length + 1),
    corColuna: { 1: function (row) { return row[1] === 'Alta' ? VERMELHO : LARANJA; } }
  });

  // ---------- Conclusão gerencial ----------
  slide = slideNovo_(pres);
  slideTitulo_(slide, 'Conclusão gerencial', 30, {});
  let conclusao = 'O relatório mostra que ' + unidadeLabel + ' manteve acompanhamento da frota no período, com ' +
    ind.checklistsRealizados + ' checklist(s) registrado(s)';
  if (ind.naoConformidadesAbertas > 0 || ind.equipamentosParadosAgora > 0) {
    conclusao += ', porém há desvios que exigem tratamento imediato: ' + ind.naoConformidadesAbertas +
      ' não conformidade(s) em aberto e ' + ind.equipamentosParadosAgora + ' equipamento(s) parado(s) neste momento.';
  } else {
    conclusao += ', sem não conformidades em aberto nem equipamentos parados no momento — situação considerada sob controle.';
  }
  if (r.rankingTempoManutencao.length) {
    conclusao += ' O equipamento ' + r.rankingTempoManutencao[0].nomeEquipamento +
      ' concentra o maior tempo de indisponibilidade e deve ser tratado como prioridade de engenharia de manutenção.';
  }
  slideTexto_(slide, conclusao, 72, { size: 12, height: 100, width: PW - 80 });

  slideTitulo_(slide, 'Observações e premissas', 185, { size: 15 });
  slideTexto_(slide,
    'Relatório gerado automaticamente a partir dos registros do app Central de Frota. O tempo em manutenção é calculado ' +
    'como conclusão menos início (ou abertura, quando não houve registro de início) e, nas manutenções ainda não concluídas, ' +
    'conta até o momento da geração. O tempo parado usa a data da última mudança de status do equipamento; equipamentos ' +
    'cadastrados antes desse controle contam a partir da data de cadastro. As prioridades do plano de ação são sugestões ' +
    'automáticas e devem ser revisadas por um gestor antes de qualquer apresentação formal.',
    215, { size: 9, color: GRAY, italic: true, height: 80, width: PW - 80 });

  // ---------- Fechamento ----------
  slide = slideNovo_(pres);
  slideTexto_(slide, 'Documento gerado automaticamente pelo app Central de Frota — ICC Brazil.', 190, { size: 11, color: GRAY, width: PW - 80 });

  pres.saveAndClose();

  // Exporta como PDF, arquiva no Drive e devolve base64 + link.
  const arquivoSlides = DriveApp.getFileById(pres.getId());
  const pdfBlob = arquivoSlides.getAs('application/pdf');
  const nomeArquivo = 'relatorio_frota_' +
    String(unidadeLabel).replace(/\s+/g, '_') + '_' +
    Utilities.formatDate(new Date(), fusoHorario_(), 'yyyy-MM-dd_HHmm') + '.pdf';
  pdfBlob.setName(nomeArquivo);

  const base64 = Utilities.base64Encode(pdfBlob.getBytes());

  let url = '';
  try {
    const pastaRelatorios = pastaPorNome_(FOLDER_RELATORIOS);
    const pdfFile = pastaRelatorios.createFile(pdfBlob);
    pdfFile.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    url = pdfFile.getUrl();
  } catch (e) { /* se o arquivamento falhar, o download por base64 ainda funciona */ }

  arquivoSlides.setTrashed(true); // não deixa a apresentação temporária acumulando no Drive

  return {
    base64: base64,
    filename: nomeArquivo,
    url: url,
    unidade: unidadeLabel,
    periodo: r.periodo
  };
}
